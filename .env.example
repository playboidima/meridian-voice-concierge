POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://meridian:change-me@db:5432/meridian
FAQ_MATCH_THRESHOLD=0.35
SEMANTIC_MATCH_THRESHOLD=0.65
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LiveKit Cloud credentials. Put real values only in .env.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice agent configuration through LiveKit Inference.
AGENT_NAME=meridian-concierge
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=en
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
TTS_LANGUAGE=en
LOG_LEVEL=INFO

# Not required while using LiveKit Inference.
LLM_API_KEY=
STT_API_KEY=
TTS_API_KEY=
